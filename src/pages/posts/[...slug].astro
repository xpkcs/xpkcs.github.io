---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import { getPublishedPosts, isoDate, postUrl, vtName, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest-first: "newer" is the previous index
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { title, date, updated, description, tags, kind, draft } = post.data;
---

<Base title={title} description={description} article={{ published: date, modified: updated, tags }} progress>
  <article class="post">
    <header class="page-head measure">
      <div class="meta">
        <time datetime={isoDate(date)}>{isoDate(date)}</time>
        {
          updated && (
            <>
              <span class="sep">·</span>
              <span>
                updated <time datetime={isoDate(updated)}>{isoDate(updated)}</time>
              </span>
            </>
          )
        }
        <span class="sep">·</span>
        <span>{remarkPluginFrontmatter.minutesRead} min</span>
        {
          kind === 'essay' && (
            <>
              <span class="sep">·</span>
              <span class="kind">essay</span>
            </>
          )
        }
        {draft && <span class="kind">[draft]</span>}
      </div>
      <h1 style={`view-transition-name: ${vtName(post)}`}>{title}</h1>
      {description && <p class="lede">{description}</p>}
      {
        tags.length > 0 && (
          <div class="meta tags">
            {tags.map((tag) => (
              <Tag tag={tag} />
            ))}
          </div>
        )
      }
      <hr class="rule" />
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager measure" aria-label="More posts">
    {
      older ? (
        <a href={postUrl(older)} rel="prev">
          <span class="dir">← older</span>
          <span class="t">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a href={postUrl(newer)} rel="next" class="next">
          <span class="dir">newer →</span>
          <span class="t">{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  .page-head h1 {
    margin-top: 0.6rem;
  }
  .tags {
    margin-top: 1rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem;
    margin: -0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .pager a:hover {
    background: var(--surface);
  }
  .pager .next {
    text-align: right;
  }
  .dir {
    color: var(--fg-muted);
    font-size: var(--step--2);
  }
  .t {
    font-weight: 600;
  }
</style>
