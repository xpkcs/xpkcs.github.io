---
import Base from '../../layouts/Base.astro';
import { getTags, tagHue, tagUrl } from '../../lib/posts';

const tags = await getTags();
---

<Base title="tags" description="Posts by topic.">
  <section class="page-head measure">
    <h1>tags</h1>
    <hr class="rule" />
  </section>
  {
    tags.size > 0 ? (
      <ul class="tag-cloud measure">
        {[...tags].map(([tag, posts]) => (
          <li>
            <a class="tag" href={tagUrl(tag)} data-hue={tagHue(tag)}>
              {tag}
            </a>
            <span class="count">{posts.length}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="meta">no tags yet.</p>
    )
  }
</Base>
